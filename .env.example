# Copy this file to .env and fill in values there.

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Plivo number supplied in the assignment, in international format.
PLIVO_FROM_NUMBER=

# Your receiver mobile number, for example +91 followed by 10 digits.
# The application will allow outbound calls only to this number.
ALLOWED_RECEIVER_NUMBER=

# Associate number supplied in the assignment, in international format.
ASSOCIATE_NUMBER=

# Public HTTPS tunnel URL. We will configure this later.
# No trailing slash.
PUBLIC_BASE_URL=

# Private access key for the demo's call button.
DEMO_ACCESS_KEY=

PORT=5000